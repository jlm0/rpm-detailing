# Copy to .env.local for local development.
# Deploy scripts pull Preview/Production values with `vercel pull`, so those live in the Vercel project.

# Neon Postgres connection string
DATABASE_URI=postgresql://user:password@host/database?sslmode=require

# Payload JWT secret, min 32 chars: openssl rand -base64 32
PAYLOAD_SECRET=

# Public site URL; drives CSRF origins and image domains
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob token for media uploads; uploads fall back to local disk when unset
BLOB_READ_WRITE_TOKEN=

# Vercel "Protection Bypass for Automation" secret; lets post-deploy E2E reach protected deployments
VERCEL_AUTOMATION_BYPASS_SECRET=
